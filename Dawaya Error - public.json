    {
      "parameters": {
        "jsCode": "// Return the quantity of expired reservations to the stock (per SKU)\nconst zone = 'Africa/Cairo';\nconst now = $now.setZone(zone);\n\nconst parse = v => {\n  const s = String(v || '').trim();\n  if (!s) return null;\n  for (const f of ['yyyy-MM-dd HH:mm', 'yyyy-MM-dd HH:mm:ss', 'M/d/yyyy H:mm:ss', 'M/d/yyyy H:mm']) {\n    const d = DateTime.fromFormat(s, f, { zone });\n    if (d.isValid) return d;\n  }\n  const iso = DateTime.fromISO(s, { zone });\n  return iso.isValid ? iso : null;\n};\n\nconst back = {};\nfor (const r of $('Read Reservations').all().map(i => i.json)) {\n  const status = String(r.status || '').toLowerCase();\n  const exp = String(r.expires_at || '').trim().toLowerCase();\n  const d = parse(r.expires_at);\n\n  const isExpired = exp === 'expired' || status === 'expired' || (d && d < now);\n  const alreadyDone = status === 'restocked';        // never count a row twice\n\n  if (r.res_id && r.sku && isExpired && !alreadyDone) {\n    back[r.sku] = (back[r.sku] || 0) + (Number(r.qty) || 0);\n  }\n}\n\nconst cat = Object.fromEntries($('Read Catalog').all().map(i => [i.json.sku, i.json]));\n\nreturn Object.entries(back)\n  .filter(([s]) => cat[s])\n  .map(([sku, q]) => ({ json: { sku, stock: Number(cat[sku].stock) + q } }));"
      },
      "type": "n8n-nodes-base.code",
